# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/timemachine

# Artifact Storage (Local filesystem root)
STORAGE_ROOT=./storage

# TinyFish Integrations (API details pending official documentation)
TINYFISH_API_KEY=placeholder_tinyfish_api_key
TINYFISH_MONITOR_ENDPOINT=https://api.tinyfish.placeholder/v1/monitors
TINYFISH_BROWSER_ENDPOINT=https://api.tinyfish.placeholder/v1/browser
TINYFISH_WEBHOOK_SECRET=placeholder_webhook_secret

# Gemma Cloud LLM Integration
GEMMA_API_KEY=placeholder_gemma_api_key
GEMMA_API_ENDPOINT=https://api.gemma.placeholder/v1/chat/completions
GEMMA_MODEL=gemma-2-9b-it

# Scheduling and Worker Configuration
SCHEDULER_INTERVAL_MS=30000
WORKER_INTERVAL_MS=10000
